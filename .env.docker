PORT=8080
RUST_LOG=pizza_store_bin=info,pizza_store_api=info,pizza_store_core=info,pizza_store_infrastructure=info,sqlx=debug,tower_http=debug
DATABASE_URL=postgres://pzstruser:password@db:5432/pzstrdb/postgres?sslmode=disable
TOKEN_SECRET=someSuperDuperSecret123
ARGON_SALT=mySuperSecretSalt123
RUN_MIGRATIONS=true
SEED=true
SQLX_OFFLINE=true
CORS_ORIGIN=http://localhost:3000

# Postgres variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres